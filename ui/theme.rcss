/* Shared look for every editor screen. Layout follows HX Edit / Helix Native: preset sidebar,
   signal flow, then the edit area (category, model, params). Colours are our own. */

body {
    font-family: UiSans;
    font-size: 14dp;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    color: #d8d8d8;
    background-color: #1b1c1f;
}

div, p { display: block; }

/* Text fields: RmlUi draws no selection by itself (no default style), so a Shift+arrow / mouse selection was there
   but invisible. Every input and textarea gets a visible selection and an explicit caret. */
input selection, textarea selection { background-color: #2f74c0; color: #ffffff; }
input, textarea { caret-color: #ffffff; }

/* ---------------------------------------------------------------- tab rail */
/* Left edge, full height. Open: icon + label. Closed: icons only, label pops out on hover. */
.rail {
    flex: 0 0 auto;
    width: 150dp;
    display: flex;
    flex-direction: column;
    background-color: #16171a;
    border-right: 1dp #111214;
}
.rail.closed { width: 42dp; }
.rail-tab {
    position: relative;
    display: flex;
    align-items: center;
    height: 40dp;
    padding: 0 10dp;
    color: #8a8d93;
    border-left: 3dp transparent;
    cursor: pointer;
}
.rail-tab:hover { color: #ffffff; background-color: #222327; }
.rail-tab.active { color: #ffffff; background-color: #2a2b2f; border-left-color: #2f74c0; }
.rail-tab.toggle { border-bottom: 1dp #111214; }
.rail-gap { flex: 1 1 auto; }
.icon {
    font-family: lucide;
    font-size: 18dp;
    width: 18dp;
    text-align: center;
    flex: 0 0 auto;
}
.rail-label { margin-left: 12dp; white-space: nowrap; }
.rail.closed .rail-label { display: none; }
.rail.closed .rail-tab:hover .rail-label {
    display: block;
    position: absolute;
    left: 44dp;
    top: 8dp;
    z-index: 10;
    margin-left: 0;
    padding: 2dp 8dp;
    color: #ffffff;
    background-color: #3c3f45;
    border-radius: 3dp;
}

/* Everything right of the rail: top bar, then the current page. */
/* Growing boxes use `flex: 1 1 0px`, not `auto`: with an auto basis RmlUi first lays out the whole subtree to
   measure it, and nested levels multiply that (a slider drag cost ~250 ms per frame). They only take the space
   left over, so the basis doesn't change the result. */
.shell { flex: 1 1 0px; display: flex; flex-direction: column; min-width: 0; }
.page { flex: 1 1 0px; display: flex; flex-direction: column; min-height: 0; }
.page.off { display: none; }

/* The Firmware tab's notice: a dimmed cover over the whole tab (it takes the clicks), the box in its middle. */
.fw-page { position: relative; }
.notice-cover {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000b0;
}
.notice {
    width: 720dp;
    max-height: 94%;
    overflow-y: auto;  /* a small window: the box scrolls instead of running off the page */
    padding: 24dp 30dp;
    border: 1dp #3a3c41;
    border-left: 4dp #e8c040;
    border-radius: 5dp;
    background-color: #1f2023;
    font-size: 15dp;
    color: #c8c8c8;
}
.notice-title { margin-bottom: 20dp; font-size: 22dp; font-weight: bold; color: #ffffff; }
.notice p { margin: 0 0 10dp 0; line-height: 1.35em; }
.notice p.notice-gap { margin-top: 16dp; }
.notice p.notice-more { margin-top: 28dp; color: #a9acb2; }
.notice-section { margin: 30dp 0 12dp 0; font-size: 16dp; font-weight: bold; color: #e8c040; }
.notice-step { display: flex; margin: 8dp 0 8dp 16dp; }
.notice-unit { flex: 0 0 auto; width: 160dp; color: #ffffff; }
.notice-how { flex: 1 1 0px; min-width: 0; }
/* A link to a web page (open_url): opens in the system's browser. */
.link { color: #6ab0ff; text-decoration: underline; cursor: pointer; }
.link:hover { color: #9ccbff; }
.notice-actions { display: flex; align-items: center; margin-top: 30dp; }
.notice-actions .button { padding: 6dp 18dp; font-size: 15dp; }

/* Simple pages (firmware, settings): a scrolling column of rows. */
.page-body { padding: 14dp 20dp; }
.page-title { font-size: 20dp; font-weight: bold; color: #ffffff; margin-bottom: 10dp; }
.page-head { display: flex; align-items: center; margin-bottom: 10dp; }
.page-head .page-title { margin-bottom: 0; }
.page-section {
    margin: 18dp 0 6dp 0;
    padding-bottom: 3dp;
    font-size: 12dp;
    font-weight: bold;
    color: #c8c8c8;
    border-bottom: 1dp #2f3035;
}
.page-body p { margin: 6dp 0; color: #a9acb2; max-width: 760dp; }
.page-body .hint { margin-top: 4dp; font-size: 12dp; color: #6b6e74; }
.info-row { display: flex; align-items: center; padding: 3dp 0; }
.info-label { flex: 0 0 auto; width: 120dp; color: #8a8d93; }
.info-value { flex: 1 1 auto; color: #d8d8d8; }
.info-row .button { margin-left: 12dp; flex: 0 0 auto; }
.bad { color: #ff6b5e; font-weight: bold; }
.warning { padding: 2dp 0; color: #ffaa55; }
.rec-row { display: flex; padding: 2dp 0; }
.rec-row:hover { background-color: #222327; }
.rec-head { color: #8a8d93; font-size: 12dp; font-weight: bold; }
.rec-head:hover { background-color: transparent; }
.rec-name { flex: 0 0 auto; width: 220dp; }
.rec-size { flex: 0 0 auto; width: 90dp; text-align: right; padding-right: 20dp; }
.rec-crc { flex: 0 0 auto; width: 90dp; color: #8a8d93; }
.rec-checks { flex: 1 1 auto; }
.grow { flex: 1 1 auto; }

/* ---------------------------------------------------------------- Firmware page: Unit / Open file / Flash */
/* Sub-tabs across the top; each shows its section's state (coloured by tone) so it reads without opening it. */
.fw-tabs {
    flex: 0 0 auto;
    display: flex;
    padding: 12dp 20dp 0 20dp;
    background-color: #16171a;
    border-bottom: 1dp #2f3035;
}
.fw-tab {
    flex: 0 0 auto;
    width: 230dp;
    margin-right: 6dp;
    padding: 8dp 14dp 9dp 14dp;
    border-radius: 6dp 6dp 0 0;
    border-width: 0 0 3dp 0;
    border-color: transparent;
    background-color: #1f2024;
    cursor: pointer;
}
.fw-tab:hover { background-color: #26272c; }
.fw-tab.active { background-color: #1b1c1f; border-color: #2f74c0; }
.fw-tab-name { font-size: 13dp; font-weight: bold; color: #8a8d93; }
.fw-tab.active .fw-tab-name { color: #ffffff; }
.fw-tab-state { margin-top: 3dp; font-size: 12dp; white-space: nowrap; overflow: hidden; color: #6b6e74; }
/* Tones: ours = green, stock = blue, bad = red, none = grey. */
.fw-tab-state.ours, .tone-ours { color: #6fcf7f; }
.fw-tab-state.stock, .tone-stock { color: #6aa8ec; }
.fw-tab-state.bad, .tone-bad { color: #ff6b5e; }

/* The card that opens each section: label, the state in big type, a line of detail, then rows. The left bar
   carries the tone. */
.fw-card {
    margin-bottom: 8dp;
    padding: 14dp 18dp 12dp 18dp;
    max-width: 900dp;
    border-radius: 6dp;
    border-width: 0 0 0 4dp;
    border-color: #3a3c42;
    background-color: #222327;
}
.fw-card.ours { border-color: #6fcf7f; }
.fw-card.stock { border-color: #6aa8ec; }
.fw-card.bad { border-color: #ff6b5e; }
.fw-card-head { display: flex; align-items: center; }
.fw-card-label { font-size: 12dp; font-weight: bold; color: #8a8d93; }
.fw-headline { margin-top: 4dp; font-size: 26dp; font-weight: bold; color: #ffffff; }
.fw-headline.small { font-size: 18dp; }
.fw-card.ours .fw-headline { color: #6fcf7f; }
.fw-card.stock .fw-headline { color: #6aa8ec; }
.fw-card.bad .fw-headline { color: #ff6b5e; }
.fw-detail { margin: 2dp 0 8dp 0; color: #a9acb2; }
/* Our builds: one tile per mod the registry knows; the ones not in the build are dimmed. */
.fw-mods { display: flex; flex-wrap: wrap; margin: 4dp 0 10dp 0; }
.fw-mod {
    flex: 0 0 auto;
    width: 250dp;
    margin: 0 8dp 8dp 0;
    padding: 8dp 12dp;
    border-radius: 5dp;
    border-width: 1dp;
    border-color: #3d6b47;
    background-color: #1f2b22;
}
.fw-mod.off { border-color: #34363b; background-color: #1d1e21; }
.fw-mod-name { font-size: 11dp; font-weight: bold; color: #6fcf7f; }
.fw-mod.off .fw-mod-name { color: #6b6e74; }
.fw-mod-title { margin-top: 2dp; font-size: 15dp; font-weight: bold; color: #ffffff; }
.fw-mod.off .fw-mod-title { color: #8a8d93; }
.fw-mod-what { margin-top: 2dp; font-size: 12dp; color: #a9acb2; }
.fw-mod.off .fw-mod-what { color: #6b6e74; }

/* Scrolling lists: .fill takes the space its flex parent gives it; .scroll fills .fill exactly, so
   its height never comes from its content and the wheel has something to scroll. */
.fill { flex: 1 1 0px; position: relative; min-height: 0; }
.scroll { position: absolute; top: 0; bottom: 0; left: 0; right: 0; overflow-y: auto; }

/* ---------------------------------------------------------------- IRs tab: slot list left, details right */
.ir-page { flex: 1 1 0px; display: flex; flex-direction: row; min-height: 0; }
.ir-list { flex: 1 1 0px; display: flex; flex-direction: column; min-width: 0; padding: 14dp 0 0 20dp; }
.ir-head { padding-right: 12dp; }
.ir-summary { flex: 0 0 auto; margin-right: 12dp; color: #8a8d93; font-size: 12dp; }
.ir-row { display: flex; padding: 3dp 8dp; cursor: pointer; }
.ir-row:hover { background-color: #2a2b2f; }
.ir-row.selected { background-color: #3a3c41; color: #ffffff; }
.ir-row.blank { color: #5c5f65; }
.ir-num { flex: 0 0 auto; width: 44dp; color: #8a8d93; }
.ir-name { flex: 1 1 0px; white-space: nowrap; overflow: hidden; }
.ir-kind { flex: 0 0 auto; margin: 0 8dp; padding: 0 5dp; border-radius: 2dp; font-size: 11dp; color: #0b1a1c;
           background-color: #00e5ff; }
.ir-filter { flex: 0 0 auto; display: flex; padding: 0 12dp 8dp 0; }
.ir-detail { flex: 0 0 auto; width: 340dp; padding: 14dp 20dp; border-left: 1dp #2f3035; }
.ir-detail .hint { padding: 10dp 0; font-size: 12dp; }
input.ir-name-edit {
    flex: 1 1 0px;
    height: 20dp;
    padding: 2dp 6dp;
    border-radius: 3dp;
    background-color: #151619;
    border: 1dp #3a3c41;
    color: #ffffff;
    font-size: 12dp;
    cursor: text;
}
input.ir-name-edit:focus { border-color: #2f74c0; }
/* Global EQ fields (Settings > Helix). */
input.geq-edit {
    flex: 0 0 auto;
    width: 80dp;
    height: 20dp;
    padding: 2dp 6dp;
    border-radius: 3dp;
    background-color: #151619;
    border: 1dp #3a3c41;
    color: #ffffff;
    font-size: 12dp;
    text-align: right;
    cursor: text;
}
input.geq-edit:focus { border-color: #2f74c0; }
.geq-unit { margin-left: 8dp; color: #8a8d93; font-size: 12dp; }
input.cc-edit { width: 40dp; margin-left: 6dp; text-align: center; }

/* ---------------------------------------------------------------- Helix tab: Global EQ */
/* Like HX Edit's Global EQ window: a dark panel with Reset / Apply EQ / power on top, the graph, the band columns and
   the level. Band colours: low cut / high cut yellow, low peak red, mid teal, high blue. */
.eq-panel { max-width: 920dp; padding: 10dp 12dp 12dp 12dp; background-color: #1f2023; border-radius: 6dp; }
.eq-head { display: flex; align-items: center; margin-bottom: 10dp; }
.eq-apply-label { margin-right: 8dp; font-size: 11dp; font-weight: bold; color: #8a8d93; }
select.eq-apply { width: 160dp; margin-right: 0; }
.eq-power {
    width: 32dp;
    height: 24dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4dp;
    background-color: #2a2b2f;
    color: #6b6e74;
    cursor: pointer;
}
.eq-power:hover { background-color: #34363b; }
.eq-power.on { color: #ffffff; background-color: #2f74c0; }
/* The graph: 2 dB grid (0 dB brighter), log frequency grid; labels top and right inside the frame. */
.eq-graph {
    position: relative;
    height: 290dp;
    background-color: #121315;
    border: 1dp #1f4a4a;
}
.eq-hline { position: absolute; left: 0; right: 0; height: 1dp; background-color: #1d1f22; }
.eq-hline.major { background-color: #3a3c42; }
.eq-hline span { position: absolute; right: 4dp; top: -7dp; font-size: 10dp; color: #8a8d93; }
.eq-vline { position: absolute; top: 0; bottom: 0; width: 1dp; background-color: #1a1c1f; }
.eq-vline.major { background-color: #25272b; }
.eq-vline span { position: absolute; left: -10dp; width: 20dp; top: 3dp; text-align: center; font-size: 10dp; color: #8a8d93; }
/* The curve: an anti-aliased image drawn at the graph's exact size (GlobalEqView), shown 1:1 over the grid. */
img.eq-curve { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.eq-bypassed {
    position: absolute;
    left: 0;
    right: 0;
    top: 44%;
    text-align: center;
    font-size: 16dp;
    font-weight: bold;
    color: #e0453a;
}
/* A handle, centred on its point; dragged in place ("drag: drag": drag events, no copy). Peaks: a filled dot;
   cuts: a ring. */
.eq-handle {
    position: absolute;
    width: 16dp;
    height: 16dp;
    margin-left: -8dp;
    margin-top: -8dp;
    box-sizing: border-box;
    border-radius: 8dp;
    border: 2dp transparent;
    cursor: move;
    drag: drag;
    z-index: 2;
}
.eq-handle.low { background-color: #c8372d; }
.eq-handle.mid { background-color: #2a9d88; }
.eq-handle.high { background-color: #4572c0; }
.eq-handle.lowcut, .eq-handle.highcut { border-color: #c9b519; background-color: #121315; }
.eq-handle.selected { border-color: #ffffff; }
.eq-handle.off { opacity: 0.7; }
/* The band columns under the graph. */
.eq-bands { display: flex; margin-top: 8dp; }
.eq-band { flex: 1 1 0px; padding: 8dp 10dp; border-radius: 4dp; cursor: pointer; }
.eq-band.selected { background-color: #2a2a22; }
.eq-band-name { margin-bottom: 6dp; text-align: center; font-weight: bold; }
.eq-band.lowcut .eq-band-name, .eq-band.highcut .eq-band-name { color: #e2cc22; }
.eq-band.low .eq-band-name { color: #e0453a; }
.eq-band.mid .eq-band-name { color: #3cc2aa; }
.eq-band.high .eq-band-name { color: #6a9ae6; }
.eq-param { margin-bottom: 6dp; }
.eq-param-row { display: flex; align-items: center; }
.eq-param-label { flex: 1 1 auto; font-size: 12dp; }
.eq-band.lowcut .eq-param-label, .eq-band.highcut .eq-param-label { color: #e2cc22; }
.eq-band.low .eq-param-label { color: #e0453a; }
.eq-band.mid .eq-param-label { color: #3cc2aa; }
.eq-band.high .eq-param-label { color: #6a9ae6; }
input.eq-value {
    flex: 0 0 auto;
    width: 70dp;
    padding: 1dp 4dp;
    border: 1dp transparent;
    border-radius: 3dp;
    background-color: transparent;
    color: #ffffff;
    font-size: 12dp;
    text-align: right;
    cursor: text;
}
input.eq-value:hover { border-color: #3a3c41; }
input.eq-value:focus { border-color: #2f74c0; background-color: #151619; }
.eq-steps { flex: 0 0 auto; display: flex; flex-direction: column; margin-left: 2dp; }
.eq-steps .icon { font-size: 10dp; line-height: 9dp; color: #a9acb2; cursor: pointer; }
.eq-steps .icon:hover { color: #ffffff; }
/* The bar: a thin track with the value's position, in the band's colour. */
input.eq-bar { display: block; width: 100%; height: 6dp; margin-top: 2dp; }
input.eq-bar slidertrack { height: 4dp; margin-top: 1dp; background-color: #2a2b2f; border-radius: 2dp; }
input.eq-bar sliderbar { width: 10dp; height: 6dp; border-radius: 2dp; background-color: #c8c8c8; }
input.eq-bar sliderarrowdec, input.eq-bar sliderarrowinc { width: 0; height: 0; }
.eq-band.lowcut input.eq-bar sliderbar, .eq-band.highcut input.eq-bar sliderbar { background-color: #e2cc22; }
.eq-band.low input.eq-bar sliderbar { background-color: #e0453a; }
.eq-band.mid input.eq-bar sliderbar { background-color: #3cc2aa; }
.eq-band.high input.eq-bar sliderbar { background-color: #6a9ae6; }
.eq-level { width: 260dp; margin: 6dp auto 0 auto; }
.eq-band-actions { display: flex; justify-content: flex-end; margin-top: 2dp; }
/* Global settings (Settings > Helix). */
.gs-layout { position: absolute; top: 0; bottom: 0; left: 0; right: 0; display: flex; }
.gs-pages { flex: 0 0 auto; width: 170dp; padding: 10dp 0; overflow-y: auto; background-color: #1b1c1f;
            border-right: 1dp #111214; }
.gs-main { flex: 1 1 0px; position: relative; min-width: 0; }
.gs-page { padding: 7dp 16dp; color: #a9acb2; cursor: pointer; }
.gs-page:hover { background-color: #26272b; color: #ffffff; }
.gs-page.active { background-color: #2f3035; color: #e8c040; border-left: 3dp #e8c040; padding-left: 13dp; }
.gs-body { padding: 14dp 20dp; }
.gs-title { margin-bottom: 8dp; font-size: 16dp; font-weight: bold; color: #e0e0e0; }
.gs-row { display: flex; align-items: center; max-width: 640dp; min-height: 30dp; padding: 3dp 0; border-bottom: 1dp #26272b; }
.gs-label { flex: 1 1 auto; color: #c8c8c8; }
.gs-control { flex: 0 0 auto; width: 300dp; display: flex; justify-content: flex-end; }
.gs-segs { display: flex; border: 1dp #3a3c41; border-radius: 3dp; }
.gs-seg { padding: 2dp 10dp; color: #a9acb2; cursor: pointer; white-space: nowrap; border-left: 1dp #3a3c41; }
.gs-seg:first-child { border-left-width: 0; }
.gs-seg:hover { background-color: #2f3035; color: #ffffff; }
.gs-seg.on { background-color: #2f74c0; color: #ffffff; }
.gs-list { display: flex; width: 220dp; padding: 3dp 8dp; background-color: #2f3035; border-radius: 3dp; color: #e8c040;
           cursor: pointer; white-space: nowrap; overflow: hidden; }
.gs-list:hover { background-color: #383a40; }
input.gs-number { width: 80dp; height: 20dp; padding: 2dp 6dp; background-color: #1b1c1f; border: 1dp #3a3c41;
                  border-radius: 3dp; color: #ffffff; text-align: right; }
input.gs-number:focus { border-color: #2f74c0; }
.gs-unknown { color: #5c5f65; }
/* The input block's Guitar In-Z / Pad, above its knobs. */
.input-settings { flex: 0 0 auto; padding: 6dp 12dp; border-bottom: 1dp #2f3035; }
.input-setting { display: flex; align-items: center; padding: 3dp 0; }
.input-setting-label { flex: 0 0 auto; width: 110dp; color: #8a8d93; font-size: 12dp; }
.ir-actions { display: flex; margin-top: 10dp; }
.ir-actions .button { margin-right: 8dp; }
.ir-confirm { margin-top: 12dp; padding: 10dp; border: 1dp #9c2f2a; border-radius: 3dp; background-color: #241a1a; }
.ir-question { color: #ffffff; }
.ir-note { margin-top: 4dp; font-size: 12dp; color: #ffaa55; }
.ir-message { margin-top: 10dp; color: #a9acb2; }

/* ---------------------------------------------------------------- right-click menu */
.ctx-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 90; }
.ctx-menu {
    position: absolute;
    z-index: 91;
    width: 220dp;
    padding: 4dp 0;
    background-color: #2a2b30;
    border: 1dp #45474d;
    border-radius: 4dp;
    font-size: 13dp;
    color: #e0e0e0;
}
.ctx-title { padding: 4dp 12dp 6dp 12dp; font-size: 11dp; color: #8a8d93; white-space: nowrap; overflow: hidden; }
.ctx-item { padding: 4dp 12dp; cursor: pointer; white-space: nowrap; }
.ctx-item:hover { background-color: #2f74c0; color: #ffffff; }
.ctx-item.disabled { color: #5c5f65; cursor: default; }
.ctx-item.checked { color: #e8c040; }
.ctx-item.disabled:hover { background-color: transparent; color: #5c5f65; }
.ctx-sep { height: 1dp; margin: 4dp 8dp; background-color: #3c3f45; }
/* A row of colour dots in the menu (the snapshot colours' classes give the fills). */
.ctx-palette { display: flex; flex-wrap: wrap; align-items: center; padding: 4dp 12dp; }
.ctx-palette-label { flex: 0 0 auto; width: 100%; margin-bottom: 4dp; }
.ctx-swatch {
    flex: 0 0 auto;
    width: 14dp;
    height: 14dp;
    box-sizing: border-box;
    margin-right: 3dp;
    border-radius: 7dp;
    border: 2dp transparent;
    cursor: pointer;
}
.ctx-swatch:hover { border-color: #8a8d93; }
.ctx-swatch.on { border-color: #ffffff; }

/* ---------------------------------------------------------------- status bar */
.statusbar {
    flex: 0 0 auto;
    height: 22dp;
    padding: 0 10dp;
    line-height: 22dp;
    font-size: 12dp;
    color: #8a8d93;
    background-color: #16171a;
    border-top: 1dp #111214;
    white-space: nowrap;
    overflow: hidden;
}
.button {
    padding: 3dp 12dp;
    background-color: #3c3f45;
    border-radius: 3dp;
    color: #ffffff;
    cursor: pointer;
}
.button:hover { background-color: #4b4f56; }
.button:active { background-color: #2f74c0; }

/* Placeholder page before a firmware is loaded. (Not ".empty": empty flow slots use that class.) */
.welcome {
    flex: 1 1 0px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #8a8d93;
}
.welcome .hint { margin-top: 8dp; font-size: 12dp; color: #6b6e74; }
.welcome .button { margin-top: 12dp; }

.main { flex: 1 1 0px; display: flex; flex-direction: row; min-height: 0; }

/* ---------------------------------------------------------------- sidebar */
.sidebar {
    flex: 0 0 auto;
    width: 230dp;
    display: flex;
    flex-direction: column;
    background-color: #202125;
    border-right: 1dp #111214;
}
.tabs { flex: 0 0 auto; display: flex; background-color: #2a2b2f; }
.tab { padding: 6dp 14dp; color: #8a8d93; font-weight: bold; }
.tab.active { color: #ffffff; background-color: #3a3c41; }
.section-title {
    flex: 0 0 auto;
    padding: 8dp 10dp 4dp 10dp;
    font-size: 12dp;
    font-weight: bold;
    color: #c8c8c8;
    background-color: #26272b;
}
.preset-list { background-color: #151619; }
.preset { display: flex; padding: 2dp 8dp; cursor: pointer; drag: clone; }
.preset:hover { background-color: #26272b; }
.preset.selected { background-color: #4a4c52; color: #ffffff; }
.preset:drag { background-color: #3a3c41; color: #ffffff; }
.pmark { flex: 0 0 auto; color: #e8c040; visibility: hidden; }
.preset.edited .pmark { visibility: visible; }
/* The open preset changed since it was loaded or saved (next to the name in the preset bar). */
.modified-mark { flex: 0 0 auto; margin: 0 8dp 0 -2dp; color: #e8c040; font-size: 18dp; font-weight: bold; }
.preset-actions { flex: 0 0 auto; display: flex; padding: 5dp 6dp; background-color: #202125; border-top: 1dp #111214; }
.pnum { width: 36dp; color: #c8c8c8; font-weight: bold; }

/* Dropdowns (setlist, sub-list) */
.dropdown { position: relative; flex: 0 0 auto; }
.dropdown-head {
    display: flex;
    padding: 5dp 10dp;
    background-color: #2f3035;
    border-bottom: 1dp #111214;
    color: #e8c040;
    cursor: pointer;
}
.dropdown-head:hover { background-color: #383a40; }
.caret { color: #8a8d93; }
.dropdown-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    background-color: #2f3035;
    border: 1dp #111214;
}
.dropdown-item { padding: 4dp 10dp; cursor: pointer; }
/* IR slot dropdown in a param row */
.ir-drop { flex: 0 1 auto; width: 240dp; margin-left: 10dp; }
.ir-drop .dropdown-head { padding: 2dp 8dp; border-bottom-width: 0; white-space: nowrap; overflow: hidden; }
.ir-drop .dropdown-head.open { background-color: #383a40; }
.ir-popup {
    position: absolute;
    z-index: 91;
    width: 300dp;
    overflow-y: auto;
    padding: 2dp 0;
    background-color: #2a2b30;
    border: 1dp #45474d;
    border-radius: 3dp;
    font-size: 13dp;
    color: #e0e0e0;
}
.ir-item { padding: 3dp 10dp; cursor: pointer; white-space: nowrap; overflow: hidden; }
.ir-item:hover { background-color: #2f74c0; color: #ffffff; }
.ir-item.empty { color: #5c5f65; }
.ir-item.on { color: #e8c040; }
.dropdown-item:hover { background-color: #4a4c52; }

/* ---------------------------------------------------------------- content */
.content { flex: 1 1 0px; display: flex; flex-direction: column; min-width: 0; }

.presetbar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 36dp;
    padding: 0 12dp;
    background-color: #26272b;
    border-bottom: 1dp #111214;
}
/* The preset's name, edited in place: looks like a title until focused. */
input.preset-name {
    flex: 1 1 0px;
    min-width: 0;
    height: 24dp;
    padding: 2dp 6dp;
    margin-right: 8dp;
    border: 1dp transparent;
    border-radius: 3dp;
    background-color: transparent;
    font-size: 17dp;
    color: #ffffff;
    cursor: text;
}
input.preset-name:hover { border-color: #3a3c41; }
input.preset-name:focus { border-color: #2f74c0; background-color: #151619; }
.dsp { width: 150dp; margin-left: 14dp; }
.dsp-label { font-size: 11dp; color: #8a8d93; }
.dsp-bar { height: 5dp; background-color: #3a3c41; }
.dsp-fill { height: 5dp; background-color: #4fa3e0; }

/* Snapshots: eight buttons and the rename field. Colours are HX Edit's snapshot colour names in our own shades. */
.snapbar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 28dp;
    padding: 0 12dp;
    background-color: #1f2023;
    border-bottom: 1dp #111214;
}
.snap {
    flex: 1 1 0px;
    min-width: 0;
    display: flex;
    align-items: center;
    height: 20dp;
    margin-right: 4dp;
    padding: 0 6dp;
    border-radius: 3dp;
    background-color: #2a2b2f;
    color: #a9acb2;
    font-size: 12dp;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
}
.snap:hover { background-color: #35373c; color: #ffffff; }
.snap.selected { background-color: #4a4c52; color: #ffffff; }
.snap-label { white-space: nowrap; }
.snap-dot { flex: 0 0 auto; width: 8dp; height: 8dp; margin-right: 5dp; border-radius: 4dp; }
.snapc-0 { background-color: #8a8d93; }
.snapc-1 { background-color: #ffffff; }
.snapc-2 { background-color: #e53935; }
.snapc-3 { background-color: #e8590c; }
.snapc-4 { background-color: #f59f00; }
.snapc-5 { background-color: #fcc419; }
.snapc-6 { background-color: #40c057; }
.snapc-7 { background-color: #15aabf; }
.snapc-8 { background-color: #228be6; }
.snapc-9 { background-color: #7950f2; }
.snapc-10 { background-color: #e64980; }
/* The unit: a dot (green when connected) and the state, then Online / Offline. */
.device { flex: 0 0 auto; display: flex; align-items: center; margin: 0 0 0 16dp; font-size: 12dp; color: #8a8d93; }
.presetbar .button { margin-left: 4dp; }
.presetbar .button.on { background-color: #2f74c0; }
.pickbar { background-color: #1a2230; border-bottom: 1dp #2f74c0; }
/* In-place rename of a preset row: the field takes the label's place, same font, a blue frame. "drag: none" so
   selecting text in it doesn't start dragging the row. */
input.row-rename {
    flex: 1 1 0px;
    min-width: 0;
    margin: -2dp 0;
    padding: 1dp 4dp;
    border-radius: 2dp;
    background-color: #151619;
    border: 1dp #2f74c0;
    color: #ffffff;
    cursor: text;
    drag: none;
}
.device-dot { width: 8dp; height: 8dp; margin-right: 6dp; border-radius: 4dp; background-color: #6b6e74; }
.device.on { color: #d8d8d8; }
.device.on .device-dot { background-color: #40c057; }
.presetbar .seg { border-radius: 3dp; font-size: 12dp; }
.unitbar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 26dp;
    padding: 0 12dp;
    background-color: #1b1c1f;
    border-bottom: 1dp #111214;
    font-size: 12dp;
}
.unitbar .seg { border-radius: 3dp; }
/* Save confirmation under the preset bar. */
.savebar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding: 6dp 12dp;
    background-color: #241a1a;
    border-bottom: 1dp #9c2f2a;
    color: #ffffff;
}
.savebar .button { margin-left: 8dp; flex: 0 0 auto; }
.seg.disabled { opacity: 0.4; cursor: default; }

/* The selected snapshot's settings, one thin row under the buttons. */
.snapedit {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 26dp;
    padding: 0 12dp;
    background-color: #1b1c1f;
    border-bottom: 1dp #111214;
    font-size: 12dp;
}
.snap-field { flex: 0 0 auto; margin: 0 6dp 0 12dp; color: #8a8d93; }
.snap-field:first-child { margin-left: 0; }
.snap-unit { flex: 0 0 auto; margin-left: 4dp; color: #8a8d93; }
.snap-colours { flex: 0 0 auto; display: flex; align-items: center; }
.snap-colours .snap-dot { width: 12dp; height: 12dp; margin-right: 3dp; border-radius: 6dp; border: 2dp transparent; cursor: pointer; }
.snap-colours .snap-dot.on { border-color: #ffffff; }
.snap-colours .snap-dot:hover { border-color: #8a8d93; }
input.snap-name, input.snap-tempo {
    flex: 0 0 auto;
    width: 150dp;
    height: 20dp;
    padding: 2dp 6dp;
    border-radius: 3dp;
    background-color: #151619;
    border: 1dp #3a3c41;
    color: #ffffff;
    font-size: 12dp;
    cursor: text;
}
input.snap-tempo { width: 50dp; }
input.snap-name:focus, input.snap-tempo:focus { border-color: #2f74c0; }
.button.small { flex: 0 0 auto; padding: 1dp 10dp; margin-left: 4dp; font-size: 12dp; }

/* Amp / Cab tabs; Bypass / Controller Assign; Command Center */
.seg-row { display: flex; flex-wrap: wrap; }
.cab-tabs { flex: 0 0 auto; padding: 4dp 12dp 0 12dp; }
.cab-tabs .seg { border-radius: 3dp; }
.seg-row .seg { margin-bottom: 2dp; border-radius: 3dp; }
.fs-insp-title { margin-bottom: 8dp; font-size: 16dp; font-weight: bold; color: #e0e0e0; }
/* Bypass / Controller Assign (HX Edit's layout): the table on the left, the selected row's editor on the right. */
.ca-table { flex: 0 0 auto; width: 420dp; display: flex; flex-direction: column; min-height: 0; border-right: 1dp #111214; }
.ca-row { display: flex; padding: 3dp 8dp; cursor: pointer; font-size: 13dp; }
.ca-row:hover { background-color: #26272b; }
.ca-row.selected { background-color: #3a3c41; }
.ca-head { cursor: default; font-weight: bold; color: #e0e0e0; background-color: #1b1c1f; border-bottom: 1dp #111214; }
.ca-head:hover { background-color: #1b1c1f; }
.ca-head .ca-col { cursor: pointer; }
.ca-col { flex: 1 1 0px; min-width: 0; white-space: nowrap; overflow: hidden; text-align: center; }
.ca-empty { padding: 10dp; }
.ca-editor { flex: 1 1 0px; min-width: 0; padding: 8dp 14dp; overflow-y: auto; }
.ca-line { display: flex; align-items: center; margin-bottom: 6dp; }
.ca-line .swatch { flex: 0 0 auto; margin-right: 6dp; }
.ca-block { flex: 0 0 auto; margin-right: 10dp; color: #e0e0e0; }
.ca-field { flex: 0 0 auto; width: 76dp; font-size: 11dp; color: #8a8d93; }
.ca-drop { flex: 1 1 0px; display: flex; padding: 3dp 8dp; background-color: #2f3035; border-radius: 3dp; cursor: pointer;
           white-space: nowrap; overflow: hidden; }
.ca-drop:hover { background-color: #383a40; }
.ca-drop.small { flex: 0 0 auto; width: 180dp; }
.ca-prop { display: flex; align-items: center; margin-top: 8dp; font-size: 13dp; }
.ca-prop-name { flex: 1 1 auto; color: #e8c040; }
.ca-prop-value { flex: 0 0 auto; margin-right: 6dp; color: #e0e0e0; }
input.slider.ca-slider { display: block; width: 100%; margin-top: 3dp; }
input.ca-label { width: 220dp; }
/* Command Center grid (HX Edit's layout). */
.cc-grid-wrap { flex: 0 0 auto; width: 420dp; padding: 8dp 10dp; border-right: 1dp #111214; overflow-y: auto; }
.cc-snap { margin: 0 0 8dp 0; font-size: 12dp; color: #8a8d93; }
.cc-grid-row { display: flex; }
.cc-cell { flex: 0 0 auto; width: 62dp; height: 56dp; margin: 0 2dp 2dp 0; padding: 4dp 3dp; background-color: #1b1c1f;
           border: 1dp #26272b; cursor: pointer; text-align: center; }
.cc-cell:hover { background-color: #26272b; }
.cc-cell.selected { background-color: #3a3c41; border-color: #00b8b8; }
.cc-cell.instant .cc-name { color: #e8c040; }
.cc-name { font-size: 12dp; color: #c8c8c8; white-space: nowrap; overflow: hidden; }
.cc-type { margin-top: 6dp; font-size: 10dp; color: #6b6e74; white-space: nowrap; overflow: hidden; }
.cc-cell.set .cc-type { color: #00e5ff; }
.swatch.cat-none { background-color: #8a8d93; }

/* Signal flow */
.flow {
    flex: 0 0 auto;
    padding: 8dp 12dp;
    background-color: #111214;
    border-bottom: 1dp #2a2b2f;
}
.lane { display: flex; align-items: center; height: 60dp; }
.lane-label { width: 26dp; font-size: 11dp; color: #6b6e74; }
.lane-track { flex: 1 1 0px; display: flex; position: relative; height: 60dp; }
.lane-line {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 16dp;   /* centre 17dp = cell padding 4dp + half a 26dp node */
    height: 2dp;
    background-color: #5a5d63;
}
/* Split / merge connectors, drawn in lane B's track (its line at 16-18dp; lane A's at -44..-42dp, one 60dp
   lane up; the sideways run at -6..-4dp, just below lane A's labels). Four rounded corners, as in Helix Native:
   - .bend.upper at lane A's end: top border on lane A's line, its vertical border, bottom border into the run;
   - .run: the straight sideways part, between the two corner boxes, never under a curve;
   - .bend.lower at lane B's end: top border from the run, its vertical border, bottom border on lane B's line
     (which is trimmed by one radius there, .trim-l / .trim-r, so it doesn't run under the curve).
   A corner box is one radius (10dp) wide on the side facing the run: .r = vertical border on its right, the box
   reaching left of its x; .l = vertical border on its left, reaching right. Margins centre the 2dp vertical on x.
   .straight = both ends at one x: a vertical from lane A's line down to one radius above lane B's, then .bend.corner
   (one rounded corner: vertical border, bottom border on lane B's line) turns into lane B's trimmed line. */
.bend { position: absolute; width: 10dp; border-color: #5a5d63; }
.bend.upper { top: -44dp; height: 36dp; border-top-width: 2dp; border-bottom-width: 2dp; }
.bend.lower { top: -6dp; height: 20dp; border-top-width: 2dp; border-bottom-width: 2dp; }
.bend.r { margin-left: -11dp; border-right-width: 2dp; border-top-right-radius: 10dp; border-bottom-right-radius: 10dp; }
.bend.l { margin-left: -1dp; border-left-width: 2dp; border-top-left-radius: 10dp; border-bottom-left-radius: 10dp; }
/* Straight connector's foot: 6..16dp plus its bottom border on lane B's line (16-18dp); only the lower corner rounds. */
.bend.corner { top: 6dp; height: 10dp; border-top-width: 0; border-bottom-width: 2dp; }
.bend.corner.r { border-top-right-radius: 0; }
.bend.corner.l { border-top-left-radius: 0; }
.run { position: absolute; top: -6dp; height: 2dp; margin-left: 11dp; margin-right: 11dp; background-color: #5a5d63; }
.straight { position: absolute; top: -44dp; height: 50dp; width: 2dp; margin-left: -1dp; background-color: #5a5d63; }
.lane-line.trim-l { margin-left: 11dp; }
.lane-line.trim-r { margin-right: 11dp; }
/* Grey preview of lane B on a serial path while a block / model is dragged (UiLane::ghost): its line and connectors. */
.lane.ghost .lane-line, .lane.ghost .bend, .lane.ghost .run, .lane.ghost .straight { opacity: 0.35; }
.lane.ghost .junction { display: none; }
.flow.dragging .lane.ghost .cell.empty .node { border-color: #34363b; }
/* Split / merge dot, centred on lane A's line (17dp centre, one 60dp lane up). */
.junction {
    position: absolute;
    top: -50dp;  /* lane A line centre -43dp, minus half the dot */
    width: 14dp;
    height: 14dp;
    margin-left: -7dp;
    box-sizing: border-box;
    border-radius: 7dp;
    border: 2dp #8a8d93;
    background-color: #1f2023;
    cursor: pointer;
    z-index: 2;
    drag: drag;  /* drag events on the dot itself, no copy: it follows the gap under the pointer */
}
.junction:hover { border-color: #c8c8c8; }
.junction.selected { border-color: #ffffff; background-color: #3a3c41; }
.cell.io.hidden .node { border-color: transparent; background-color: transparent; }

.cell {
    position: relative;  /* stack above the absolutely positioned lane line, so presses reach the blocks */
    flex: 1 1 0px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 4dp;
    cursor: pointer;
}
.grip { width: 56dp; display: flex; flex-direction: column; align-items: center; }
.node {
    position: relative;      /* anchors the icon */
    box-sizing: border-box;  /* 26dp including the border, so the centre lines up with the lane line */
    width: 26dp;
    height: 26dp;
    border-radius: 4dp;
    border: 2dp transparent;
}
.cell.io .node { border-radius: 13dp; border-color: #c8c8c8; background-color: #2a2b2f; }
.cell.io { cursor: pointer; }
.cell.io.hidden { cursor: default; }
.cell.io.selected .node { border-color: #ffffff; }
/* Drag sources: RmlUi drags a copy placed at the source's left edge with its content width, so drag
   the fixed-width grip (node + label), not the wide cell whose centred content would jump left. The
   events bubble to the cell. The cell under the copy gets .droptarget (dragover/dragout events). */
.cell.block .grip, .model-row { drag: clone; }
/* Lane B's own input / output node: drag it onto lane A to turn it back into a split / merge. */
.cell.dragio .grip { drag: drag; cursor: move; }
.model-row:drag { background-color: #3a3c41; color: #ffffff; padding: 3dp 10dp; }
/* Empty slots keep the same 26dp box as every node (only colours change), so an outline drawn
   on one sits exactly on the lane line. Hidden until hovered, selected or targeted by a drop. */
.cell.empty .node { border-color: transparent; background-color: transparent; }
.cell.empty:hover .node { border-color: #4a4c52; }
/* An unused lane B (serial path) shows no hover boxes; it still lights up as a drop target. */
.lane.idle .cell.empty:hover .node { border-color: transparent; }
.cell.empty.selected .node { border-color: #ffffff; background-color: #2a2b2f; }
/* Stronger than the idle-lane hover rule above and the drag outline: during a drag the target is also hovered. */
.cell.empty.droptarget .node, .lane.idle .cell.empty.droptarget:hover .node,
.flow.dragging .lane.idle .cell.empty.droptarget .node { border-color: #ffffff; }
.cell.block .node { background-color: #1f2023; }
.cell.bypassed .node { opacity: 0.35; }
.cell.bypassed .cell-label { opacity: 0.45; }
.cell-label { margin-top: 2dp; font-size: 11dp; color: #a8a8a8; }

/* Edit area */
.edit-tabs { flex: 0 0 auto; display: flex; background-color: #26272b; }
.edit-tab {
    flex: 1 1 0px;
    text-align: center;
    padding: 5dp 0;
    font-size: 12dp;
    font-weight: bold;
    color: #8a8d93;
    cursor: pointer;
}
.edit-tab:hover { color: #c8c8c8; }
.edit-tab.active { color: #ffffff; background-color: #3a3c41; }
.edit-tab.disabled { color: #55585e; }

.edit { flex: 1 1 0px; display: flex; flex-direction: row; min-height: 0; }
.col { display: flex; flex-direction: column; min-height: 0; border-right: 1dp #111214; }
.categories { flex: 0 0 auto; width: 170dp; background-color: #1b1c1f; }
.cat-row { display: flex; align-items: center; padding: 3dp 10dp; cursor: pointer; }
.cat-row:hover { background-color: #2a2b2f; }
.cat-row.selected { background-color: #3a3c41; }
.cat-row.disabled { opacity: 0.35; cursor: default; }
.swatch { width: 12dp; height: 12dp; border-radius: 3dp; margin-right: 8dp; }

.models { flex: 0 0 auto; width: 230dp; background-color: #1b1c1f; }
.model-row { padding: 3dp 10dp; cursor: pointer; }
.model-row:hover { background-color: #2a2b2f; }
.model-row.selected { background-color: #3a3c41; color: #ffffff; }
/* Doesn't fit in the path's DSP: shown, but can't be picked. */
.model-row.disabled { opacity: 0.35; cursor: default; }
.model-row.disabled:hover { background-color: transparent; }

.params { flex: 1 1 0px; border-right: 0; background-color: #1b1c1f; }
.params-head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding: 5dp 12dp;
    background-color: #2f3035;
    border-bottom: 1dp #111214;
}
.block-title { flex: 1 1 auto; color: #ffffff; }
.power {
    padding: 1dp 8dp;
    border-radius: 3dp;
    font-size: 11dp;
    font-weight: bold;
    background-color: #3a3c41;
    color: #8a8d93;
    cursor: pointer;
}
.power.on { background-color: #2f74c0; color: #ffffff; }
.hint { flex: 0 0 auto; padding: 10dp 12dp; color: #8a8d93; }
.param-list { padding: 4dp 12dp; }
.param { padding: 4dp 0; }
.param-top { display: flex; }
.param-name { font-size: 13dp; }
.param-value { font-size: 13dp; }

/* Parameter bars as in Helix Native: a dark rounded track, a fill in a mid shade of the category colour (from the
   left, or from the middle for pan / balance), and the handle in the full colour, rounded like the buttons.
   Track and fill are our own divs under the range input, whose own track is see-through. */
.bar { position: relative; height: 14dp; margin-top: 2dp; }
.bar-track, .bar-fill { position: absolute; top: 3dp; height: 8dp; border-radius: 3dp; }
.bar-track { left: 0; right: 0; background-color: #2f3134; }
.bar-fill { background-color: #606469; }
input.slider { display: block; position: relative; width: 100%; height: 14dp; }
input.slider slidertrack { height: 8dp; margin-top: 3dp; background-color: transparent; }
input.slider sliderbar { width: 12dp; height: 14dp; border-radius: 3dp; background-color: #c8c8c8; }
input.slider sliderarrowdec, input.slider sliderarrowinc { width: 0; height: 0; }

scrollbarvertical { width: 10dp; }
scrollbarvertical slidertrack { background-color: #1b1c1f; }
scrollbarvertical sliderbar { background-color: #4a4d53; border-radius: 4dp; min-height: 20dp; }
scrollbarvertical sliderbar:hover { background-color: #5c6067; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

/* ---------------------------------------------------------------- category colours (generated) */
/* From the unit's own block icons (dominant colour of each category's icon in rec 9, v3.80); the dark shade is
   that colour at 28% over the background, for node boxes and slider tracks. */
.cat-0.cat-text, .cat-0.cell-label, .cat-0.block-title, .param-list.cat-0 .param-name, .param-list.cat-0 .param-value { color: #9aa0a6; }
.cat-0.swatch { background-color: #9aa0a6; }
.cell.block .node.cat-0, .grip:drag .node.cat-0 { border-color: #9aa0a6; background-color: #36383b; }
.param-list.cat-0 input.slider slidertrack { background-color: #36383b; }
.param-list.cat-0 input.slider sliderbar { background-color: #9aa0a6; }
.cat-1.cat-text, .cat-1.cell-label, .cat-1.block-title, .param-list.cat-1 .param-name, .param-list.cat-1 .param-value { color: #9aa0a6; }
.cat-1.swatch { background-color: #9aa0a6; }
.cell.block .node.cat-1, .grip:drag .node.cat-1 { border-color: #9aa0a6; background-color: #36383b; }
.param-list.cat-1 input.slider slidertrack { background-color: #36383b; }
.param-list.cat-1 input.slider sliderbar { background-color: #9aa0a6; }

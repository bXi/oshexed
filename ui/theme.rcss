/* ---------------------------------------------------------------- flash page */
.options { margin: 8dp 0 4dp 0; }
.toggle { display: flex; align-items: center; padding: 4dp 0; cursor: pointer; }
.toggle .box {
    display: block;
    width: 12dp;
    height: 12dp;
    margin-right: 8dp;
    border: 1dp #6b6e74;
    border-radius: 2dp;
}
.toggle.on .box { background-color: #2f74c0; border-color: #2f74c0; }
.toggle:hover { color: #ffffff; }
.seg {
    flex: 0 0 auto;
    padding: 2dp 10dp;
    margin-right: 2dp;
    background-color: #2a2b2f;
    color: #a9acb2;
    cursor: pointer;
}
.seg.on { background-color: #2f74c0; color: #ffffff; }
.presets-why { margin-left: 10dp; color: #8a8d93; }
.rec-plan { flex: 0 0 auto; width: 150dp; color: #a9acb2; }
.rec-row.skip { color: #6b6e74; }
.rec-row.skip .rec-plan { color: #6b6e74; }
.rec-row.done .rec-checks { color: #6fcf7f; }
.rec-checks { display: flex; align-items: center; }
.mini-bar { flex: 0 0 auto; width: 80dp; height: 6dp; margin-right: 8dp; background-color: #2a2b2f; }
.mini-fill { height: 6dp; background-color: #2f74c0; }
.rec-row.done .mini-fill { background-color: #3f9f55; }
.summary { margin-top: 8dp; color: #d8d8d8; }
.actions { display: flex; align-items: center; margin-top: 12dp; }
.actions .button { margin-right: 8dp; }
.button.danger { background-color: #9c2f2a; }
.button.danger:hover { background-color: #b93a33; }
.button.quiet { background-color: transparent; color: #8a8d93; }
.button.quiet:hover { color: #ffffff; background-color: #2a2b2f; }
.button.disabled { opacity: 0.4; }
.confirm, .progress, .recovery {
    margin-top: 14dp;
    padding: 12dp 14dp;
    background-color: #24252a;
    border: 1dp #3a3c41;
    border-radius: 4dp;
}
.confirm { border-color: #9c2f2a; }
.recovery { border-color: #ffaa55; }
.confirm-title, .progress-title { font-weight: bold; color: #ffffff; margin-bottom: 6dp; }
.big-bar { height: 14dp; background-color: #16171a; border-radius: 3dp; }
.big-fill { height: 14dp; background-color: #2f74c0; border-radius: 3dp; }
.big-fill.failed { background-color: #9c2f2a; }
.progress-text { margin-top: 6dp; color: #a9acb2; font-size: 13dp; }
.ok-text { margin-top: 8dp; color: #6fcf7f; }
.log-line { font-size: 12dp; color: #8a8d93; padding: 1dp 0; }

/* ---------------------------------------------------------------- mods page (marketplace) */
.mods-signed { margin: 4dp 0; font-size: 12dp; color: #6fcf7f; }
.mods-signed.unsigned { color: #ffaa55; }
.mods-list { max-width: 900dp; margin: 10dp 0; }
.mods-row { display: flex; align-items: center; padding: 5dp 6dp; border-radius: 3dp; cursor: pointer; }
.mods-row:hover { background-color: #222327; }
.mods-row.on { background-color: #1f2b3a; }
.mods-row.always { cursor: default; }
.mods-head { color: #8a8d93; font-size: 12dp; font-weight: bold; cursor: default; }
.mods-head:hover { background-color: transparent; }
.mods-check { flex: 0 0 auto; width: 26dp; }
.mods-check .box { display: block; width: 12dp; height: 12dp; border: 1dp #6b6e74; border-radius: 2dp; }
.mods-row.on .mods-check .box { background-color: #2f74c0; border-color: #2f74c0; }
.mods-name { flex: 1 1 auto; }
.mods-needs { font-size: 11dp; color: #6b6e74; }
.mods-ver, .mods-slot { flex: 0 0 auto; width: 70dp; color: #a9acb2; }
.mods-size { flex: 0 0 auto; width: 90dp; color: #a9acb2; }
.mods-state { flex: 0 0 auto; width: 120dp; color: #8a8d93; }
.mods-state.ok { color: #6fcf7f; }
.mods-progress { max-width: 900dp; margin-top: 14dp; }
/* Build report: a fixed-height text box (textarea.mon-box, as the USB log) that scrolls on its own. */
.mods-report-bar { display: flex; align-items: center; max-width: 900dp; margin: 14dp 0 6dp 0; }
.mods-report-bar.off, .mods-report-wrap.off { display: none; }
.mods-report-title { font-size: 13dp; font-weight: bold; color: #e0e0e0; }
.mods-report-wrap { position: relative; max-width: 900dp; height: 380dp; margin-bottom: 10dp; }

/* ---------------------------------------------------------------- monitor page */
.mon-bar { flex: 0 0 auto; display: flex; align-items: center; padding: 10dp 20dp 6dp 20dp; }
.mon-bar .button { margin-left: 8dp; flex: 0 0 auto; }
.mon-bar .button:first-child { margin-left: 0; }
.mon-bar .toggle { margin-left: 16dp; flex: 0 0 auto; }
.mon-bar .hint { font-size: 12dp; color: #6b6e74; }
.button.primary { background-color: #2f74c0; color: #ffffff; }
.mon-ports { flex: 0 0 auto; display: flex; flex-wrap: wrap; align-items: center; padding: 0 20dp 6dp 20dp; font-size: 12dp; }
.mon-port { margin-right: 14dp; color: #a9acb2; }
.mon-list { padding: 4dp 20dp 12dp 20dp; }
/* USB log: a text box (selectable). The wrap fills the space left; the box fills the wrap. */
.mon-box-wrap { flex: 1 1 0px; position: relative; min-height: 0; margin: 0 20dp 12dp 20dp; }
/* A textarea has an intrinsic size (rows / cols): offsets alone don't stretch it, an explicit 100% does. */
textarea.mon-box {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 6dp 8dp;
    border-radius: 4dp;
    background-color: #151619;
    border: 1dp #2f3035;
    color: #a9acb2;
    font-size: 12dp;
    line-height: 16dp;
    white-space: pre;
    overflow: auto;
    cursor: text;
}
textarea.mon-box:focus { border-color: #2f74c0; }
textarea.mon-box selection { background-color: #2f74c0; color: #ffffff; }
textarea.mon-box scrollbarhorizontal { height: 10dp; }
textarea.mon-box scrollbarhorizontal slidertrack { background-color: #1b1c1f; }
textarea.mon-box scrollbarhorizontal sliderbar { background-color: #4a4d53; border-radius: 4dp; min-width: 20dp; }
/* MIDI port dropdown. RmlUi draws nothing for a select by itself: value box, arrow and list are styled here. */
select.mon-port-select {
    flex: 0 0 auto;
    width: 260dp;
    height: 22dp;
    margin-right: 10dp;
    padding: 2dp 24dp 2dp 8dp;
    border-radius: 3dp;
    background-color: #151619;
    border: 1dp #3a3c41;
    color: #ffffff;
    font-size: 13dp;
    cursor: pointer;
}
select.mon-port-select:hover { border-color: #4b4f56; }
select.mon-port-select selectvalue { height: 18dp; white-space: nowrap; overflow: hidden; }
select.mon-port-select selectarrow {
    width: 0;
    height: 0;
    margin-top: 8dp;
    margin-right: 8dp;
    border-width: 5dp 4dp 0 4dp;
    border-color: #a9acb2 transparent transparent transparent;
}
select.mon-port-select selectbox {
    margin-top: 2dp;
    padding: 3dp 0;
    background-color: #222327;
    border: 1dp #3a3c41;
    border-radius: 3dp;
}
select.mon-port-select selectbox option { padding: 3dp 8dp; color: #d8d8d8; }
select.mon-port-select selectbox option:hover { background-color: #2f74c0; color: #ffffff; }
select.mon-port-select selectbox option:checked { color: #6fcf7f; }
.mon-row:hover { background-color: #222327; }
.mon-row { display: flex; font-size: 12dp; color: #a9acb2; padding: 1dp 0; }
.mon-row.debug { color: #6fcf7f; }
.mon-time { flex: 0 0 auto; width: 80dp; color: #6b6e74; }
.mon-port-name { flex: 0 0 auto; width: 200dp; color: #6b6e74; white-space: nowrap; overflow: hidden; }
/* The four debug words as tiles above the message list. */
.mon-words { flex: 0 0 auto; display: flex; flex-wrap: wrap; align-items: flex-end; padding: 4dp 20dp 8dp 20dp; border-bottom: 1dp #2f3035; }
.mon-word {
    flex: 0 0 auto;
    width: 150dp;
    margin-right: 8dp;
    padding: 6dp 10dp;
    border-radius: 5dp;
    border-width: 1dp;
    border-color: #3d6b47;
    background-color: #1f2b22;
}
.mon-word.off { border-color: #34363b; background-color: #1d1e21; }
.mon-word-name { font-size: 11dp; font-weight: bold; color: #6fcf7f; }
.mon-word.off .mon-word-name { color: #6b6e74; }
.mon-word-value { font-size: 20dp; font-weight: bold; color: #ffffff; }
.mon-word.off .mon-word-value { color: #6b6e74; }
.mon-word-sub { font-size: 11dp; color: #8a8d93; }
.mon-words-hint { flex: 1 1 200dp; margin: 0 0 4dp 8dp; font-size: 12dp; color: #6b6e74; }

/* ---------------------------------------------------------------- firmware icons */
/* Block icons from the user's firmware (rec 8/9), frame included, as Helix Native draws them: grey frame,
   white for the selected block (the icon's own Sel variant), dimmed when bypassed (Off). Drawn over the 26dp
   node box and centred on it so the lane line still runs through the middle. The icon's black is see-through,
   so a dark fill behind it stops the lane line at the frame; the selected block's fill is its category's dark
   shade, as in Native. */
.node-icon {
    position: absolute;
    left: -6dp;              /* 34dp centred on the 26dp box (inside its 2dp border) */
    top: -6dp;
    width: 34dp;
    height: 34dp;
    border-radius: 5dp;      /* keeps the fill inside the frame's rounded corners */
    background-color: #111214;
}
.node.has-icon { border-color: transparent; background-color: transparent; }
.cell.bypassed .node.has-icon { opacity: 1; }
.lane .cell.block.selected .grip .node.has-icon, .lane .cell.block.droptarget .grip .node.has-icon,
.grip:drag .node.has-icon { border-color: transparent; background-color: transparent; }
/* Input / output nodes with the unit's Block_In* / Block_Out* image (36x38 px, round): no circle of ours under it. */
.cell.io .node.has-icon { border-color: transparent; background-color: transparent; }
.cell.io .node-icon { left: -4dp; top: -5dp; width: 30dp; height: 32dp; border-radius: 16dp; }
/* Path 2A / 2B / 2A+B outputs: 36x66 (circle + arrow down), kept at their own ratio. The image has 14 px of empty
   space above its circle (the round ones start at the top), so it moves up by that (14 x 30/36 = 11.7dp) to put the
   circle on the line where the round ones sit; the arrow hangs below, and the label moves down past it. */
.cell.io .node-icon.tall { top: -17dp; height: 55dp; border-radius: 0; background-color: transparent; }
.cell-label.tall { margin-top: 13dp; }
/* Behind a tall icon's circle (centre 11dp / 10dp in the node, as the round icons'), the flow's colour: the lane line
   stops at the circle's edge, as it does at the round icons, whose own background does the same. */
.cell.io .node-disc {
    position: absolute;
    left: -4dp;
    top: -5dp;
    width: 30dp;
    height: 30dp;
    border-radius: 15dp;
    background-color: #111214;
}
/* Drop target while dragging: a lighter fill behind the icon. */
.cell.block.droptarget .node-icon { background-color: #3a3c41; }
/* Selected block: its category's dark shade behind the icon. */
.cell.block.selected .node.cat-0 .node-icon { background-color: #36383b; }
.cell.block.selected .node.cat-1 .node-icon { background-color: #36383b; }
.cell.block.selected .node.cat-2 .node-icon { background-color: #503415; }
.cell.block.selected .node.cat-3 .node-icon { background-color: #4b471a; }
.cell.block.selected .node.cat-4 .node-icon { background-color: #4b471a; }
.cell.block.selected .node.cat-5 .node-icon { background-color: #0b344d; }
.cell.block.selected .node.cat-6 .node-icon { background-color: #1d521e; }
.cell.block.selected .node.cat-7 .node-icon { background-color: #522413; }
.cell.block.selected .node.cat-8 .node-icon { background-color: #3b204a; }
.cell.block.selected .node.cat-9 .node-icon { background-color: #3b204a; }
.cell.block.selected .node.cat-10 .node-icon { background-color: #3b204a; }
.cell.block.selected .node.cat-11 .node-icon { background-color: #4d1215; }
.cell.block.selected .node.cat-12 .node-icon { background-color: #4d1215; }
.cell.block.selected .node.cat-13 .node-icon { background-color: #4d1215; }
.cell.block.selected .node.cat-14 .node-icon { background-color: #440b0c; }
.cell.block.selected .node.cat-15 .node-icon { background-color: #4d1936; }
.cell.block.selected .node.cat-16 .node-icon { background-color: #1d403f; }
.cell.block.selected .node.cat-17 .node-icon { background-color: #0f5254; }
.cell.block.selected .node.cat-18 .node-icon { background-color: #343436; }
.cell.block.selected .node.cat-19 .node-icon { background-color: #005c66; }
.cat-icon { flex: 0 0 auto; width: 24dp; height: 24dp; margin-right: 6dp; }

/* ---------------------------------------------------------------- parameter bars per category */
/* Track: the category colour at 16% over the background (darker than the old track); fill: at 55%, between the
   track and the handle's full colour. The range input's own track stays see-through (beats the generated
   slidertrack rules above: same specificity, later). */
.scroll.param-list input.slider slidertrack { background-color: transparent; }
.param-list.cat-0 .bar-track { background-color: #2f3134; } .param-list.cat-0 .bar-fill { background-color: #606469; }

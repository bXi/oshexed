/* A block whose IR slot holds the wrong kind (an IR block on a NAM capture, the NAM block on an IR). Last in the
   file: beats the category colours (same specificity). */
.cell.block .node.ir-warn, .grip:drag .node.ir-warn { border-color: #ff3b30; }
.ir-warn.cell-label { color: #ff6b5e; }
